# Task: T2-002, T3-006 - Backend environment configuration
# From: specs/phase2-web/spec.md §6, specs/phase3-ai-chatbot/tasks.md

# PostgreSQL Database URL (Neon)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT Configuration (must match Better Auth secret)
BETTER_AUTH_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256

# CORS Origins (frontend URL)
CORS_ORIGINS=["http://localhost:3000"]

# Gemini AI Configuration (Phase III)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.7
